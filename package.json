{
  "name": "luisasilvaramos-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@netlify/plugin-nextjs": "^5.16.9",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
