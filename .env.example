# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente · Luísa Silva Ramos
#
# Copie para `.env.local` (nunca commite esse arquivo) e preencha.
# Tudo é validado em src/env/schema.ts: se algo estiver errado, o build e o
# servidor param com uma mensagem dizendo QUAL variável falhou (sem mostrar o valor).
#
# Na Netlify, cadastre em: Site configuration → Environment variables,
# escolhendo o contexto (Production / Deploy previews).
# ─────────────────────────────────────────────────────────────────────────────

# ── Fase 1 · Fundação ────────────────────────────────────────────────────────

# Ambiente lógico: local | test | preview | production.
# Na Netlify é definido pelo netlify.toml; localmente pode ficar em branco.
APP_ENV=

# URL pública do site. Em branco: http://localhost:3000 (local) ou a URL que a
# Netlify informa (preview/produção).
NEXT_PUBLIC_SITE_URL=

# "true" SOMENTE em produção depois do go-live. Antes disso o site fica fora do Google.
SITE_INDEXABLE=false

# debug | info | warn | error
LOG_LEVEL=info

# Preenchida automaticamente pela Netlify (commit do deploy). Deixe em branco.
COMMIT_REF=

# ── Fase 3 · Banco de dados e cifragem ───────────────────────────────────────

# Postgres da aplicação (Neon, URL do *pooler*). Em produção: usuário SEM permissão de DDL.
# Local com Docker:  postgres://postgres:postgres@localhost:5432/lsr_dev
DATABASE_URL=

# Usuário com permissão de criar tabelas, só para `npm run db:migrate` (CI / responsável).
# NÃO cadastre na Netlify.
DATABASE_MIGRATION_URL=

# Banco descartável para `npm run test:db` (padrão: postgres://postgres@localhost:5433/lsr_test).
DATABASE_URL_TEST=

# Chaves de cifragem (AES-256-GCM, 32 bytes em base64). Gere com:  openssl rand -base64 32
# Formato "v1:<chave>"; para rotacionar, acrescente ",v2:<nova>" e mude ENC_ACTIVE_KEY para v2.
# Perder a chave = perder os endereços e observações cifrados. Guarde no cofre de senhas.
ENC_KEYS=
ENC_ACTIVE_KEY=

# Fase 4a · Assina as cotações de deslocamento (HMAC). Mínimo 32 caracteres.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BOOKING_SIGNING_SECRET=

# SÓ desenvolvimento/testes: troca a busca de CEP por um falso determinístico. Recusado em produção.
FAKE_EXTERNAL_SERVICES=

# SÓ testes: liga os testes E2E de agendamento (precisam de banco com serviços e endereço-base).
BOOKING_E2E=

# Só no ambiente local do Codespace/nuvem, se o Chromium já vier instalado em outro caminho.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# ── Fase 4b · E-mails (Resend) ───────────────────────────────────────────────
# Sem RESEND_API_KEY: local/testes gravam os e-mails em `.emails/` (abra o .html);
# preview/produção deixam os e-mails na fila até a chave ser cadastrada.

# Chave da API do Resend (começa com "re_"). Segredo: só na Netlify, nunca no repositório.
RESEND_API_KEY=

# Remetente num domínio verificado no Resend. Obrigatório se houver RESEND_API_KEY.
# EMAIL_FROM="Luísa Silva Ramos <agenda@luisasilvaramos.com.br>"
EMAIL_FROM=

# Para onde vão as respostas das clientes (caixa da Luísa).
EMAIL_REPLY_TO=

# Recebe os avisos de novo pedido, cancelamento e remarcação.
EMAIL_ADMIN_NOTIFY=

# ── Próximas fases (ainda não lidas pela aplicação) ──────────────────────────
# Fase 4 · API de rotas para a taxa de deslocamento.
# ROUTES_API_KEY=
#
# Fase 4c · Anti-bot (Cloudflare Turnstile)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
#
# Fase 4 · Rate limit (Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Fase 5 · Autenticação do painel
# AUTH_SECRET=
#
# Fase 5 · Dados da contratada no contrato (nunca no repositório)
# CONTRACTOR_NAME=
# CONTRACTOR_DOCUMENT=
#
# Fase 6 · Tarefas agendadas
# CRON_SECRET=
#
# Observabilidade (Sentry) · opcional
# SENTRY_DSN=
